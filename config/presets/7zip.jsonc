    {
      "id": "edit-7zip-config",
      "title": "Edit 7-Zip config",
      "tooltip": "Open the deployed JSONC preset to customize optional commands.",
      "icon": "__none",
      "command": "%LOCALAPPDATA%\\MyContextMenuTools\\Presets\\7zip.jsonc",
      "appliesTo": ["files", "folders"]
    }
  ]
}
