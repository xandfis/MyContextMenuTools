{
  "id": "7zip",
  "title": "7-Zip",
  "icon": "%ProgramFiles%\\7-Zip\\7zFM.exe",
  "children": [
    {
      "id": "7zip-open",
      "title": "Open archive",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zFM.exe",
      "arguments": "%1",
      "includeExtensions": [".7z", ".zip", ".rar", ".tar", ".gz", ".xz", ".bz2", ".cab", ".iso", ".wim"]
    },
    {
      "type": "separator"
    },
    {
      "id": "7zip-extract-files",
      "title": "Extract files...",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "x -ad %1",
      "includeExtensions": [".7z", ".zip", ".rar", ".tar", ".gz", ".xz", ".bz2", ".cab", ".iso", ".wim"]
    },
    {
      "id": "7zip-extract-here",
      "title": "Extract here",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "x %1 -o{parent}",
      "includeExtensions": [".7z", ".zip", ".rar", ".tar", ".gz", ".xz", ".bz2", ".cab", ".iso", ".wim"]
    },
    {
      "id": "7zip-extract-to-folder",
      "title": "Extract to \"{stem}\\\"",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "x %1 -o{parent}\\{stem}",
      "includeExtensions": [".7z", ".zip", ".rar", ".tar", ".gz", ".xz", ".bz2", ".cab", ".iso", ".wim"]
    },
    {
      "id": "7zip-test-archive",
      "title": "Test archive",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "t %1",
      "includeExtensions": [".7z", ".zip", ".rar", ".tar", ".gz", ".xz", ".bz2", ".cab", ".iso", ".wim"]
    },
    {
      "type": "separator"
    },
    {
      "id": "7zip-add-to-archive",
      "title": "Add to archive...",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "a -ad {parent}\\{name} %*",
      "appliesTo": ["files", "folders"]
    },
    {
      "id": "7zip-compress-and-email",
      "title": "Compress and email...",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "a -ad -seml. {parent}\\{name} %*",
      "appliesTo": ["files", "folders"]
    },
    {
      "id": "7zip-add-to-7z",
      "title": "Add to \"{name}.7z\"",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "a -t7z {parent}\\{name}.7z %*",
      "appliesTo": ["files", "folders"]
    },
    {
      "id": "7zip-compress-to-7z-and-email",
      "title": "Compress to \"{name}.7z\" and email",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "a -t7z -seml. {parent}\\{name}.7z %*",
      "appliesTo": ["files", "folders"]
    },
    {
      "id": "7zip-add-to-zip",
      "title": "Add to \"{name}.zip\"",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "a -tzip {parent}\\{name}.zip %*",
      "appliesTo": ["files", "folders"]
    },
    {
      "id": "7zip-compress-to-zip-and-email",
      "title": "Compress to \"{name}.zip\" and email",
      "icon": "__none",
      "command": "%ProgramFiles%\\7-Zip\\7zG.exe",
      "arguments": "a -tzip -seml. {parent}\\{name}.zip %*",
      "appliesTo": ["files", "folders"]
    },
