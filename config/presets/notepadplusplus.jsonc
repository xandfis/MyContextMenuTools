{
  "id": "notepad-plus-plus",
  "title": "Edit with Notepad++",
  "icon": "%ProgramFiles%\\Notepad++\\notepad++.exe",
  "command": "%ProgramFiles%\\Notepad++\\notepad++.exe",
  "arguments": "%*",
  "appliesTo": ["files"],
  "excludeExtensions": [".exe", ".dll", ".sys", ".obj", ".lib", ".pdb", ".png", ".jpg", ".jpeg", ".gif", ".zip", ".7z", ".rar", ".msi", ".msix", ".pdf"]
}
